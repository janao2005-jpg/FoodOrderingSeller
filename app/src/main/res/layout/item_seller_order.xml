<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="6dp" app:cardBackgroundColor="@color/white" app:cardCornerRadius="18dp" app:cardElevation="2dp" app:strokeColor="#1A281638" app:strokeWidth="1dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/sellerOrderIdTextView" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Order #0000000" android:textColor="@color/aklny_plum" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:id="@+id/sellerOrderStatusTextView" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/aklny_secondary_button" android:paddingHorizontal="10dp" android:paddingVertical="5dp" android:text="Placed" android:textColor="@color/aklny_plum" android:textSize="12sp" />
        </LinearLayout>
        <TextView android:id="@+id/sellerOrderDateTextView" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Today" android:textColor="@color/aklny_plum_light" android:textSize="12sp" />
        <TextView android:id="@+id/sellerOrderItemsTextView" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="2 × Burger" android:textColor="@color/aklny_plum" android:textSize="14sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginTop="12dp">
            <TextView android:id="@+id/sellerOrderTotalTextView" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Your items · 0.00" android:textColor="@color/aklny_plum" android:textSize="14sp" android:textStyle="bold" />
            <com.google.android.material.button.MaterialButton android:id="@+id/sellerOrderActionButton" android:layout_width="wrap_content" android:layout_height="42dp" android:text="Accept order" android:textAllCaps="false" android:textColor="@color/aklny_plum" app:backgroundTint="@color/aklny_mint" app:cornerRadius="14dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
