<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/aklny_cream"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AKLNY  ·  SELLER"
                android:textColor="@color/aklny_plum_light"
                android:textSize="14sp"
                android:textStyle="bold" />
            <View
                android:layout_width="42dp"
                android:layout_height="4dp"
                android:layout_marginTop="6dp"
                android:background="@color/aklny_lime" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/sellerDashboardGreetingTextView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Welcome back"
                    android:textColor="@color/aklny_plum"
                    android:textSize="25sp"
                    android:textStyle="bold" />
                <ImageButton
                    android:id="@+id/sellerDashboardProfileButton"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:padding="13dp"
                    android:src="@drawable/ic_nav_profile"
                    android:scaleType="fitCenter"
                    android:contentDescription="Open profile"
                    android:background="@drawable/aklny_back_button" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="@color/aklny_plum"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp">
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center_vertical"
                        android:paddingStart="20dp"
                        android:paddingEnd="136dp"
                        android:paddingTop="18dp"
                        android:paddingBottom="18dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Fresh stock. Happy customers."
                            android:textColor="@color/aklny_cream"
                            android:textSize="25sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Keep your menu up to date and follow every order from one place."
                            android:textColor="@color/aklny_cream"
                            android:textSize="14sp" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/sellerDashboardProductsButton"
                            android:layout_width="wrap_content"
                            android:layout_height="52dp"
                            android:layout_marginTop="16dp"
                            android:text="Manage products"
                            android:textAllCaps="false"
                            android:textColor="@color/aklny_plum"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/aklny_mint"
                            app:cornerRadius="16dp" />
                    </LinearLayout>
                    <ImageView
                        android:layout_width="136dp"
                        android:layout_height="230dp"
                        android:layout_gravity="end|center_vertical"
                        android:contentDescription="Fresh groceries in a shopping basket"
                        android:scaleType="fitCenter"
                        android:src="@drawable/seller_grocery_basket" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="Shop overview"
                android:textColor="@color/aklny_plum"
                android:textSize="25sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="128dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardBackgroundColor="@color/seller_metric_bg"
                    app:cardCornerRadius="22dp" app:strokeColor="@color/aklny_lavender" app:strokeWidth="1dp"
                    app:cardElevation="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="12dp" android:paddingBottom="12dp">
                        <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_nav_products" android:contentDescription="" />
                        <TextView android:id="@+id/sellerProductCountTextView" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="-" android:textColor="@color/aklny_plum" android:textSize="38sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Active products" android:textColor="@color/aklny_plum" android:textSize="16sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="128dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    app:cardBackgroundColor="@color/seller_metric_bg"
                    app:cardCornerRadius="22dp" app:strokeColor="@color/aklny_lavender" app:strokeWidth="1dp"
                    app:cardElevation="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="12dp" android:paddingBottom="12dp">
                        <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_nav_cart" android:contentDescription="" />
                        <TextView android:id="@+id/sellerOrderCountTextView" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="-" android:textColor="@color/aklny_plum" android:textSize="38sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Incoming orders" android:textColor="@color/aklny_plum" android:textSize="16sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sellerDashboardOrdersButton"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="20dp"
                android:text="View incoming orders"
                android:textAllCaps="false"
                android:textColor="@color/aklny_plum"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@color/aklny_mint"
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_arrow_forward"
                app:iconGravity="end"
                app:iconTint="@color/aklny_plum" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:background="@color/white"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp">
        <Button android:id="@+id/sellerDashboardBottomHomeButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Home" android:drawableTop="@drawable/ic_nav_home" android:drawablePadding="2dp" android:gravity="center" android:paddingTop="4dp" android:paddingBottom="4dp" android:textAllCaps="false" android:textColor="@color/aklny_plum" android:backgroundTint="@color/aklny_mint" android:textSize="13sp" />
        <Button android:id="@+id/sellerDashboardBottomProductsButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Products" android:drawableTop="@drawable/ic_nav_products" android:drawablePadding="2dp" android:gravity="center" android:paddingTop="4dp" android:paddingBottom="4dp" android:textAllCaps="false" android:textColor="@color/aklny_plum" android:backgroundTint="@color/white" android:textSize="13sp" />
        <Button android:id="@+id/sellerDashboardBottomOrdersButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Orders" android:drawableTop="@drawable/ic_nav_cart" android:drawablePadding="2dp" android:gravity="center" android:paddingTop="4dp" android:paddingBottom="4dp" android:textAllCaps="false" android:textColor="@color/aklny_plum" android:backgroundTint="@color/white" android:textSize="13sp" />
        <Button android:id="@+id/sellerDashboardBottomProfileButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Profile" android:drawableTop="@drawable/ic_nav_profile" android:drawablePadding="2dp" android:gravity="center" android:paddingTop="4dp" android:paddingBottom="4dp" android:textAllCaps="false" android:textColor="@color/aklny_plum" android:backgroundTint="@color/white" android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>