<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/aklny_cream">

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AKLNY  ·  SELLER" android:textColor="@color/aklny_plum_light" android:textSize="12sp" android:textStyle="bold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginTop="8dp">
                <TextView android:id="@+id/sellerDashboardGreetingTextView" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Welcome back" android:textColor="@color/aklny_plum" android:textSize="24sp" android:textStyle="bold" />
                <Button android:id="@+id/sellerDashboardProfileButton" android:layout_width="48dp" android:layout_height="48dp" android:text="●" android:contentDescription="Open profile" android:background="@drawable/aklny_back_button" android:textColor="@color/aklny_plum" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Your shop at a glance" android:textColor="@color/aklny_plum_light" android:textSize="14sp" />

            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" app:cardBackgroundColor="@color/aklny_plum" app:cardCornerRadius="24dp" app:cardElevation="2dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Fresh stock. Happy customers." android:textColor="@color/aklny_lime" android:textSize="21sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Keep your menu up to date and follow every order from one place." android:textColor="@color/aklny_cream" android:textSize="14sp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/sellerDashboardProductsButton" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginTop="18dp" android:text="Manage products" android:textAllCaps="false" android:textColor="@color/aklny_plum" app:backgroundTint="@color/aklny_mint" app:cornerRadius="16dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Shop overview" android:textColor="@color/aklny_plum" android:textSize="18sp" android:textStyle="bold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp">
                <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="110dp" android:layout_weight="1" android:layout_marginEnd="6dp" app:cardBackgroundColor="@color/white" app:cardCornerRadius="20dp" app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical" android:padding="16dp">
                        <TextView android:id="@+id/sellerProductCountTextView" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="@color/aklny_plum" android:textSize="28sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Active products" android:textColor="@color/aklny_plum_light" android:textSize="13sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="110dp" android:layout_weight="1" android:layout_marginStart="6dp" app:cardBackgroundColor="@color/white" app:cardCornerRadius="20dp" app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical" android:padding="16dp">
                        <TextView android:id="@+id/sellerOrderCountTextView" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="@color/aklny_plum" android:textSize="28sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Your orders" android:textColor="@color/aklny_plum_light" android:textSize="13sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/sellerDashboardOrdersButton" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="18dp" android:text="View incoming orders" android:textAllCaps="false" android:textColor="@color/aklny_plum" app:backgroundTint="@color/aklny_lime" app:cornerRadius="18dp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:background="@color/white" android:elevation="8dp" android:gravity="center" android:orientation="horizontal" android:paddingHorizontal="4dp">
        <Button android:id="@+id/sellerDashboardBottomHomeButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="⌂\nHome" android:textAllCaps="false" android:textColor="@color/aklny_plum" android:backgroundTint="@color/aklny_mint" android:textSize="11sp" />
        <Button android:id="@+id/sellerDashboardBottomProductsButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="▦\nProducts" android:textAllCaps="false" android:textColor="@color/aklny_plum" android:backgroundTint="@color/white" android:textSize="11sp" />
        <Button android:id="@+id/sellerDashboardBottomOrdersButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="▤\nOrders" android:textAllCaps="false" android:textColor="@color/aklny_plum" android:backgroundTint="@color/white" android:textSize="11sp" />
        <Button android:id="@+id/sellerDashboardBottomProfileButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="●\nProfile" android:textAllCaps="false" android:textColor="@color/aklny_plum" android:backgroundTint="@color/white" android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
