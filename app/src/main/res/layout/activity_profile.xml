<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/profile_surface"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="18dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:text="Seller Profile"
            android:textColor="@color/aklny_plum"
            android:textSize="25sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/profileImageView"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/profile_photo_frame"
            android:contentDescription="Seller profile picture"
            android:padding="3dp"
            android:scaleType="centerCrop"
            android:src="@drawable/food_image_placeholder" />

        <Button
            android:id="@+id/selectProfilePictureButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/profile_action_button"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:text="Choose Profile Picture"
            android:textAllCaps="false"
            android:textColor="@color/aklny_plum"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/profileNameEditText"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="@color/aklny_plum_light"
            android:hint="Full name"
            android:inputType="textPersonName|textCapWords"
            android:paddingStart="3dp"
            android:paddingEnd="3dp"
            android:textColor="@color/aklny_plum"
            android:textColorHint="#9A929D"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/profileEmailEditText"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:backgroundTint="#C9C2CB"
            android:enabled="false"
            android:hint="Email address"
            android:inputType="textEmailAddress"
            android:paddingStart="3dp"
            android:paddingEnd="3dp"
            android:textColor="#8D8690"
            android:textColorHint="#A9A2AA"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/profilePhoneEditText"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="4dp"
            android:backgroundTint="@color/aklny_plum_light"
            android:hint="Phone number"
            android:inputType="phone"
            android:paddingStart="3dp"
            android:paddingEnd="3dp"
            android:textColor="@color/aklny_plum"
            android:textColorHint="#9A929D"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/profileAddressEditText"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="4dp"
            android:backgroundTint="@color/aklny_plum_light"
            android:hint="Shop address"
            android:inputType="textPostalAddress|textCapSentences"
            android:paddingStart="3dp"
            android:paddingEnd="3dp"
            android:textColor="@color/aklny_plum"
            android:textColorHint="#9A929D"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/profileRoleTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingStart="2dp"
            android:paddingBottom="2dp"
            android:text="Role: seller"
            android:textColor="@color/aklny_plum_light"
            android:textSize="15sp" />

        <Button
            android:id="@+id/saveProfileButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/profile_action_button"
            android:minHeight="0dp"
            android:text="Save Changes"
            android:textAllCaps="false"
            android:textColor="@color/aklny_plum"
            android:textSize="14sp" />

        <Button
            android:id="@+id/manageProductsButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/profile_action_button"
            android:minHeight="0dp"
            android:text="Manage Products"
            android:textAllCaps="false"
            android:textColor="@color/aklny_plum"
            android:textSize="14sp" />

        <Button
            android:id="@+id/logoutButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/profile_action_button"
            android:minHeight="0dp"
            android:text="Logout"
            android:textAllCaps="false"
            android:textColor="@color/aklny_plum"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
