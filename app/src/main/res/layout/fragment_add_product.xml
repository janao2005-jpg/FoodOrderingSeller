<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="20dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="230dp"
            android:background="@drawable/product_photo_frame">

            <ImageView
                android:id="@+id/newProductImageView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:background="@drawable/food_image_placeholder"
                android:contentDescription="Preview of selected product photo"
                android:scaleType="centerCrop"
                android:src="@drawable/food_image_placeholder" />

            <TextView
                android:id="@+id/productImageStatusTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="14dp"
                android:background="@drawable/image_status_badge"
                android:paddingStart="10dp"
                android:paddingTop="7dp"
                android:paddingEnd="10dp"
                android:paddingBottom="7dp"
                android:text="Add a product photo"
                android:textColor="@color/aklny_plum"
                android:textSize="12sp"
                android:textStyle="bold" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/selectProductImageButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:background="@drawable/aklny_secondary_button"
                android:text="Choose Photo"
                android:textAllCaps="false"
                android:textColor="@color/aklny_plum" />

            <Button
                android:id="@+id/captureProductImageButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:background="@drawable/aklny_secondary_button"
                android:text="Take Photo"
                android:textAllCaps="false"
                android:textColor="@color/aklny_plum" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Product details"
            android:textColor="@color/aklny_plum"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/newProductNameEditText"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/product_input_background"
            android:hint="Product name"
            android:inputType="textCapSentences"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/aklny_plum"
            android:textColorHint="@color/welcome_muted" />

        <EditText
            android:id="@+id/newProductCategoryEditText"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/product_input_background"
            android:hint="Category (e.g. burgers, drinks)"
            android:inputType="textCapSentences"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/aklny_plum"
            android:textColorHint="@color/welcome_muted" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/newProductPriceEditText"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:background="@drawable/product_input_background"
                android:hint="Price"
                android:inputType="numberDecimal"
                android:paddingStart="14dp"
                android:paddingEnd="10dp"
                android:textColor="@color/aklny_plum"
                android:textColorHint="@color/welcome_muted" />

            <EditText
                android:id="@+id/newProductQuantityEditText"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:background="@drawable/product_input_background"
                android:hint="Quantity in stock"
                android:inputType="number"
                android:paddingStart="14dp"
                android:paddingEnd="10dp"
                android:textColor="@color/aklny_plum"
                android:textColorHint="@color/welcome_muted" />
        </LinearLayout>

        <Button
            android:id="@+id/saveNewProductButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/aklny_primary_button"
            android:text="Save Product"
            android:textAllCaps="false"
            android:textColor="@color/aklny_plum"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>

